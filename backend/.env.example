PROJECT_NAME="Motor Editorial AI"
API_V1_STR="/api/v1"

# O backend usa backend/data por padrao.
# So defina os caminhos abaixo se quiser sobrescrever a convencao atual.
# EXCEL_PAUTAS_PATH=
# GENERATED_ARTICLES_DIR=
# GENERATED_IMAGES_DIR=

# Arquivos editaveis pela tela Configuracoes.
# CLIENT_INSTRUCTIONS_PATH=
# SEO_GUIDELINES_PATH=
# GENERATE_PAUTAS_PROMPT_PATH=
# GENERATE_ARTICLE_PROMPT_PATH=

OPENAI_API_KEY="COLOQUE_SUA_CHAVE_AQUI"
OPENAI_MODEL="gpt-5"
OPENAI_IMAGE_MODEL="gpt-image-1"
OPENAI_IMAGE_SIZE="1536x1024"
OPENAI_IMAGE_QUALITY="medium"
OPENAI_WEBSEARCH_ENABLED="true"

WORDPRESS_URL="https://blog-do-cliente.com"
WORDPRESS_USERNAME="seu_usuario"
WORDPRESS_APPLICATION_PASSWORD="xxxx xxxx xxxx xxxx xxxx"
DEFAULT_POST_STATUS="draft"

LOG_LEVEL="INFO"
# Em producao, defina apenas a origem real do dashboard servido pela VPS.
# Exemplo: CORS_ORIGINS="https://artigos.seudominio.com"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005"

# Automacao agendada. Gere um token longo e mantenha o backend acessivel apenas internamente.
CRON_ENABLED="false"
CRON_TOKEN="GERE_UM_TOKEN_LONGO_E_ALEATORIO"
CRON_MODE="generate_only"
CRON_MAX_ITEMS="1"
CRON_SCHEDULE="0 7 * * 1-5"
CRON_DRY_RUN="true"
CRON_ALLOW_UNREVIEWED_PUBLISH="false"

# Publicacao direta, sem rascunho, apos validar em dry-run:
# CRON_MODE="publish"
# CRON_DRY_RUN="false"
# CRON_ALLOW_UNREVIEWED_PUBLISH="true"
