[Unit]
Description=Motor Editorial AI - Frontend Next.js
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/motor-editorial/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
